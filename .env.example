# ─────────────────────────────────────────────────────────────
# 环境变量样例 —— 复制为 .env 后填入真实值。
# .env 不进版本库(见 .gitignore)。生产密钥务必覆盖默认值。
# ─────────────────────────────────────────────────────────────

# 运行环境:development | production
APP_ENV=development

# ── 数据库(M1 起用;M0 容器已就绪)────────────────────────
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=agent
# 应用连接串(compose 内网用服务名 postgres;本机直连用 127.0.0.1)
DATABASE_URL=postgresql+psycopg://agent:change-me-in-prod@postgres:5432/agent

# ── Redis(M4/M5 起用;M0 容器已就绪)────────────────────────
# compose 内网用服务名 redis;本机直连用 127.0.0.1(不改则任务中心 503)
REDIS_URL=redis://redis:6379/0

# ── 管理端鉴权 ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-prod
# 签 token 的密钥,务必设为长随机串(留空则每次重启失效所有 token)
ADMIN_SECRET=
ADMIN_TOKEN_TTL=43200
# 管理端监听端口(默认 8001)
# ADMIN_PORT=8001

# ── LLM / Embedding(M3 起用,国内 DashScope)──────────────
# OpenRouter: 配合 appsettings.Development.json 中 apiKey="${OPENROUTER_API_KEY}" 使用。
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# ── 存储后端切换(M1)─────────────────────────────────────
# true=运行态(会话/运行记录/长期记忆)走 PostgreSQL;false(默认)=JSON 文件
USE_DB_STORES=false

# ── 用户端 API 鉴权(P0)──────────────────────────────────
# 默认 true:所有 /api/* 需登录,写操作按角色权限。仅排障时可临时设 false。
USER_API_AUTH=true

# ── 演示种子(默认关)─────────────────────────────────────
# true=启动时注入 13 节点漫剧演示工作流(运行结果不进制作看板,仅演示用)
SEED_DEMO_WORKFLOWS=false

# ── AI 趋势自动同步(默认开)──────────────────────────────
# 每天 TRENDS_SYNC_TIME 批量刷新全部 GitHub 趋势 query,拉到新数据后强制重生成 AI 分析报告。
# 同步是当天幂等的:调度器 / Windows 计划任务 / CLI 三个入口并存也不会重复消耗 GitHub 配额。
TRENDS_AUTO_SYNC=true
TRENDS_SYNC_TIME=02:00
# GitHub 搜索 API:留空=匿名,限流仅 10 次/分钟,而一次全量同步要打 16 次(8 query × 2 次 search),
# 极易触发 403 靠 sleep 硬扛。填个 personal access token(无需任何 scope)即可提升到 30 次/分钟。
GITHUB_TOKEN=

# ── Letta（有状态 Agent 记忆运行时，:8283）────────────────
# 默认 SQLite 零配置；接 PostgreSQL 时设此项（建议独立库名 letta，与主库隔离）
# LETTA_PG_URI=postgresql+asyncpg://agent:change-me-in-prod@127.0.0.1:5432/letta

# ── 日志 ───────────────────────────────────────────────────
LOG_LEVEL=INFO
# true=JSON 结构化(生产);false=彩色控制台(开发)
LOG_JSON=false

# ── CORS(逗号分隔;生产收窄到实际域名)────────────────────
CORS_ORIGINS=*

# ── Grafana ────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
