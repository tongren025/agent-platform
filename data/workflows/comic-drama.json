    {
      "nodeKey": "image_prompt",
      "type": "agent",
      "name": "图片提示词规格",
      "position": {
        "x": 2560,
        "y": 400
      },
      "config": {
        "employeeKey": "comic-prompt-engineer",
        "userInputTemplate": "以 IMAGE 模式把已通过门禁的人物、场景、分镜和动作包编译成角色、场景、关键帧三类任务。逐项建立来源/参考映射，绑定稳定资产 ID 与版本；正向 prompt只写可见目标，negative_prompt 独立；关键帧只描述一个冻结时刻。每项执行语义、版本、引用真实性、模型参数和可提交性 validation；错误非空即 blocked。只输出规格，不调用图片工具或把提示词称为成品。\n【规格包】\n{{spec_package.output}}\n【规格 QA】\n{{spec_qa.output}}",
        "onError": "stop",
        "structuredSchemaJson": "{\"type\":\"object\",\"required\":[\"image_prompt_package\"],\"properties\":{\"image_prompt_package\":{\"type\":\"object\",\"required\":[\"project_id\",\"episode_id\",\"character_assets\",\"scene_assets\",\"keyframe_assets\",\"validation\"],\"properties\":{\"project_id\":{\"type\":\"string\"},\"episode_id\":{\"type\":\"string\"},\"character_assets\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"asset_id\",\"character_id\",\"version\",\"variant_id\",\"prompt\",\"reference_map\",\"negative_prompt\",\"size\",\"quality\",\"validation\"],\"properties\":{\"asset_id\":{\"type\":\"string\"},\"character_id\":{\"type\":\"string\"},\"version\":{\"type\":\"string\"},\"variant_id\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"reference_map\":{\"type\":\"array\"},\"negative_prompt\":{\"type\":\"string\"},\"size\":{\"type\":\"string\"},\"quality\":{\"type\":\"string\"},\"validation\":{\"type\":\"object\"}}}},\"scene_assets\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"asset_id\",\"scene_id\",\"version\",\"view_id\",\"prompt\",\"reference_map\",\"negative_prompt\",\"size\",\"quality\",\"validation\"],\"properties\":{\"asset_id\":{\"type\":\"string\"},\"scene_id\":{\"type\":\"string\"},\"version\":{\"type\":\"string\"},\"view_id\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"reference_map\":{\"type\":\"array\"},\"negative_prompt\":{\"type\":\"string\"},\"size\":{\"type\":\"string\"},\"quality\":{\"type\":\"string\"},\"validation\":{\"type\":\"object\"}}}},\"keyframe_assets\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"asset_id\",\"shot_id\",\"frame_role\",\"character_versions\",\"scene_version\",\"prompt\",\"reference_map\",\"negative_prompt\",\"size\",\"quality\",\"validation\"],\"properties\":{\"asset_id\":{\"type\":\"string\"},\"shot_id\":{\"type\":\"string\"},\"frame_role\":{\"type\":\"string\",\"enum\":[\"start\",\"end\",\"action\"]},\"character_versions\":{\"type\":\"array\"},\"scene_version\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"reference_map\":{\"type\":\"array\"},\"negative_prompt\":{\"type\":\"string\"},\"size\":{\"type\":\"string\"},\"quality\":{\"type\":\"string\"},\"validation\":{\"type\":\"object\"}}}},\"validation\":{\"type\":\"object\"}}}}}"
      }
