    {
      "nodeKey": "spec_qa",
      "type": "agent",
      "name": "规格 QA",
      "position": {
        "x": 2120,
        "y": 400
      },
      "config": {
        "employeeKey": "comic-qa-inspector",
        "userInputTemplate": "对规格包做生产前证据门禁：检查导演意图承接、剧本因果与人物主动选择、人物/场景版本、镜头叙事字段、ID 引用、时长求和、起止连续性、动作/VFX可执行性和提示词前置条件。每个问题绑定观察事实、expected、severity、责任岗位与最小返工。任何阻断项都必须 gate=FAIL；只有证据完整且 blockers 为空且 qa_report.verdict=pass 才能 gate=PASS。确定性合同审计只要出现 FAIL 或 errors，本节点不得覆盖或降级其结论。顶层 gate 必须与 qa_report.verdict 一致。\n【确定性合同审计】\n{{spec_audit.output}}\n【规格包】\n{{spec_package.output}}",
        "onError": "stop",
        "structuredSchemaJson": "{\"type\":\"object\",\"required\":[\"phase\",\"gate\",\"qa_report\"],\"properties\":{\"phase\":{\"type\":\"string\",\"const\":\"SPEC\"},\"gate\":{\"type\":\"string\",\"enum\":[\"PASS\",\"FAIL\"]},\"qa_report\":{\"type\":\"object\",\"required\":[\"scope\",\"evidence\",\"checks\",\"verdict\",\"blockers\",\"rework_tasks\",\"summary\"],\"properties\":{\"scope\":{\"type\":\"string\",\"enum\":[\"text\",\"image\",\"video\",\"mixed\"]},\"evidence\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"evidence_id\",\"type\",\"accessible\",\"asset_id\",\"shot_id\"],\"properties\":{\"evidence_id\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"},\"accessible\":{\"type\":\"boolean\"},\"asset_id\":{\"type\":\"string\"},\"shot_id\":{\"type\":\"string\"}}}},\"checks\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"check_id\",\"result\",\"severity\",\"evidence_id\",\"observation\",\"expected\",\"owner_employee_key\",\"rework\"],\"properties\":{\"check_id\":{\"type\":\"string\"},\"result\":{\"type\":\"string\",\"enum\":[\"pass\",\"fail\",\"blocked\"]},\"severity\":{\"type\":\"string\",\"enum\":[\"critical\",\"major\",\"minor\",\"info\"]},\"evidence_id\":{\"type\":\"string\"},\"observation\":{\"type\":\"string\"},\"expected\":{\"type\":\"string\"},\"owner_employee_key\":{\"type\":\"string\"},\"rework\":{\"type\":\"string\"}}}},\"verdict\":{\"type\":\"string\",\"enum\":[\"pass\",\"fail\",\"blocked\"]},\"passed_items\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"blockers\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"rework_tasks\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"summary\":{\"type\":\"string\"}}}}}"
      }
