        "onError": "stop",
        "structuredSchemaJson": "{\"type\":\"object\",\"required\":[\"script_package\"],\"properties\":{\"script_package\":{\"type\":\"object\",\"required\":[\"project_id\",\"episode_id\",\"logline\",\"theme\",\"target_duration_sec\",\"assumptions\",\"blockers\",\"scenes\",\"continuity_constraints\",\"handoff_notes\"],\"properties\":{\"project_id\":{\"type\":\"string\"},\"episode_id\":{\"type\":\"string\"},\"logline\":{\"type\":\"string\"},\"theme\":{\"type\":\"string\"},\"target_duration_sec\":{\"type\":\"number\",\"exclusiveMinimum\":0},\"assumptions\":{\"type\":\"array\"},\"blockers\":{\"type\":\"array\"},\"scenes\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"continuity_constraints\":{\"type\":\"array\"},\"handoff_notes\":{\"type\":\"array\"}}}}}"
