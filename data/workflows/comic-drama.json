        "structuredSchemaJson": "{\"type\":\"object\",\"required\":[\"image_prompt_package\"],\"properties\":{\"image_prompt_package\":{\"type\":\"object\",\"required\":[\"project_id\",\"episode_id\",\"character_assets\",\"scene_assets\",\"keyframe_assets\",\"validation\"],\"properties\":{\"project_id\":{\"type\":\"string\"},\"episode_id\":{\"type\":\"string\"},\"character_assets\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"asset_id\",\"character_id\",\"version\",\"variant_id\",\"prompt\",\"size\",\"quality\"],\"properties\":{\"asset_id\":{\"type\":\"string\"},\"character_id\":{\"type\":\"string\"},\"version\":{\"type\":\"string\"},\"variant_id\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"size\":{\"type\":\"string\"},\"quality\":{\"type\":\"string\"}}}},\"scene_assets\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"asset_id\",\"scene_id\",\"version\",\"view_id\",\"prompt\",\"size\",\"quality\"],\"properties\":{\"asset_id\":{\"type\":\"string\"},\"scene_id\":{\"type\":\"string\"},\"version\":{\"type\":\"string\"},\"view_id\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"size\":{\"type\":\"string\"},\"quality\":{\"type\":\"string\"}}}},\"keyframe_assets\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"asset_id\",\"shot_id\",\"frame_role\",\"character_versions\",\"scene_version\",\"prompt\",\"size\",\"quality\"],\"properties\":{\"asset_id\":{\"type\":\"string\"},\"shot_id\":{\"type\":\"string\"},\"frame_role\":{\"type\":\"string\",\"enum\":[\"start\",\"end\",\"action\"]},\"character_versions\":{\"type\":\"array\"},\"scene_version\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"size\":{\"type\":\"string\"},\"quality\":{\"type\":\"string\"}}}},\"validation\":{\"type\":\"object\"}}}}}"
