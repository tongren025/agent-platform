        "onError": "stop",
        "structuredSchemaJson": "{\"type\":\"object\",\"required\":[\"action_vfx_package\"],\"properties\":{\"action_vfx_package\":{\"type\":\"object\",\"required\":[\"project_id\",\"episode_id\",\"shots\",\"handoff_notes\"],\"properties\":{\"project_id\":{\"type\":\"string\"},\"episode_id\":{\"type\":\"string\"},\"shots\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"shot_id\",\"action\",\"vfx_layers\",\"continuity_in\",\"continuity_out\",\"generation_risks\",\"split_recommendation\"],\"properties\":{\"shot_id\":{\"type\":\"string\"},\"action\":{\"type\":\"object\"},\"vfx_layers\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"continuity_in\":{\"type\":\"object\"},\"continuity_out\":{\"type\":\"object\"},\"generation_risks\":{\"type\":\"array\"},\"split_recommendation\":{\"type\":\"string\"}}}},\"handoff_notes\":{\"type\":\"array\"}}}}}"
