        "onError": "stop",
        "structuredSchemaJson": "{\"type\":\"object\",\"required\":[\"phase\",\"gate\",\"qa_report\"],\"properties\":{\"phase\":{\"type\":\"string\",\"const\":\"SPEC\"},\"gate\":{\"type\":\"string\",\"enum\":[\"PASS\",\"FAIL\"]},\"qa_report\":{\"type\":\"object\",\"required\":[\"scope\",\"evidence\",\"checks\",\"verdict\",\"blockers\",\"rework_tasks\",\"summary\"],\"properties\":{\"scope\":{\"type\":\"string\",\"enum\":[\"text\",\"image\",\"video\",\"mixed\"]},\"evidence\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"checks\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"verdict\":{\"type\":\"string\",\"enum\":[\"pass\",\"fail\",\"blocked\"]},\"passed_items\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"blockers\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"rework_tasks\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"summary\":{\"type\":\"string\"}}}}}"
