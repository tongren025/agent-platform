[
  {
    "id": "song-1180-zhulong-8",
    "character_id": "zhulong",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 8,
    "pdf_page": 101,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "钟山之神，名曰烛阴……身长千里。",
    "note": "本条核对烛阴记载。书影作“千里”，角色释义中的“万里”不是本条原文。"
  },
  {
    "id": "song-1180-jiuweihu-1",
    "character_id": "jiuweihu",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 1,
    "pdf_page": 11,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "有兽焉，其状如狐而九尾，其音如婴儿，能食人，食者不蛊。",
    "note": "南山经青丘之山条。这里只认证所列摘录，不自动认证档案中的整段引文。"
  },
  {
    "id": "song-1180-xingtian-7",
    "character_id": "xingtian",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 7,
    "pdf_page": 94,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "帝断其首，葬之常羊之山，乃以乳为目，以脐为口，操干戚以舞。",
    "note": "宋本此处作“形天”；角色沿用通行名称“刑天”。"
  },
  {
    "id": "song-1180-taotie-3",
    "character_id": "taotie",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 3,
    "pdf_page": 40,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "其状如羊身人面，其目在腋下，虎齿人爪，其音如婴儿，名曰狍鸮。",
    "note": "钩吾之山条，正文名“狍鸮”；不能把后世所有饕餮形象都当作本条描述。"
  },
  {
    "id": "song-1180-qiongqi-2",
    "character_id": "qiongqi",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 2,
    "pdf_page": 32,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "有兽焉，其状如牛，蝟毛，名曰穷奇。",
    "note": "邽山条的正文为牛形、蝟毛；角色档案的虎形有翼描述不是本条正文，需分别核对。"
  },
  {
    "id": "song-1180-jinwu-9",
    "character_id": "jinwu",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 9,
    "pdf_page": 105,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "汤谷上有扶桑，十日所浴……九日居下枝，一日居上枝。",
    "note": "本条正文记扶桑十日；同页郭璞注谈日中三足乌。角色名“金乌”不等于此处正文的用词。"
  },
  {
    "id": "song-1180-bifang-2",
    "character_id": "bifang",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 2,
    "pdf_page": 28,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "有鸟焉，其状如鹤，一足，赤文青质而白喙，名曰毕方。",
    "note": "章莪之山条。"
  },
  {
    "id": "song-1180-yinglong-14",
    "character_id": "yinglong",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 14,
    "pdf_page": 122,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "应龙处南极，杀蚩尤与夸父，不得复上。",
    "note": "凶犁土丘条；档案若引用“大荒北经”中的黄帝使应龙故事，须与本条分别阅读。"
  },
  {
    "id": "song-1180-chiyou-17",
    "character_id": "chiyou",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 17,
    "pdf_page": 135,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "蚩尤作兵伐黄帝，黄帝乃令应龙攻之冀州之野。",
    "note": "本条可直接查阅蚩尤、黄帝、应龙与女魃故事；档案中拼接的其他句子仍待逐句校勘。"
  },
  {
    "id": "song-1180-nuwa-16",
    "character_id": "nuwa",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 16,
    "pdf_page": 127,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "有神十人，名曰女娲之肠。",
    "note": "正文记女娲之肠，郭璞注另述女娲。补天、抟土造人的完整故事不能由这条正文证明。"
  },
  {
    "id": "song-1180-xiangliu-8",
    "character_id": "xiangliu",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 8,
    "pdf_page": 102,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "共工之臣曰相柳氏，九首，以食于九山。",
    "note": "海外北经相柳条；大荒北经另有相繇记载，不能无说明地拼成一段。"
  },
  {
    "id": "song-1180-kuafu-8",
    "character_id": "kuafu",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 8,
    "pdf_page": 102,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "夸父与日逐走，入日……道渴而死，弃其杖，化为邓林。",
    "note": "海外北经夸父逐日条。省略号表示本次未摘录的中间文字。"
  },
  {
    "id": "song-1180-jingwei-3",
    "character_id": "jingwei",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 3,
    "pdf_page": 45,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "其状如乌，文首、白喙、赤足，名曰精卫……常衔西山之木石，以堙于东海。",
    "note": "北次三经发鸠之山条。"
  },
  {
    "id": "song-1180-kuiniu-14",
    "character_id": "kuiniu",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 14,
    "pdf_page": 123,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "其名曰夔。黄帝得之，以其皮为鼓。",
    "note": "流波山条始于PDF第122页左侧，名称及黄帝制鼓续于第123页右侧；同页左侧已开始卷十五。"
  },
  {
    "id": "song-1180-luwu-2",
    "character_id": "luwu",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 2,
    "pdf_page": 26,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "神陆吾司之，其神状虎身而九尾，人面而虎爪。",
    "note": "昆仑之丘的陆吾记载。陆吾与海内西经开明兽分别建出处，不直接认定二者为同一神。"
  },
  {
    "id": "song-1180-luwu-11",
    "character_id": "luwu",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 11,
    "pdf_page": 111,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "开明兽身大类虎而九首，皆人面，东向立昆仑上。",
    "note": "此条为角色档案所合称的“开明兽”，与陆吾的九尾描述分开核对。"
  },
  {
    "id": "song-1180-dijiang-2",
    "character_id": "dijiang",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 2,
    "pdf_page": 29,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "有神焉，其状如黄囊，赤如丹火，六足四翼，浑敦无面目……实惟帝江也。",
    "note": "天山条。正文“浑敦无面目”描述帝江，不是犬形混沌引文。"
  },
  {
    "id": "song-1180-bashe-10",
    "character_id": "bashe",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 10,
    "pdf_page": 109,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "巴蛇食象，三岁而出其骨。",
    "note": "海内南经巴蛇条；本张扫描左侧已开始海内西经，右侧仍属卷十。"
  },
  {
    "id": "song-1180-zhuque-1",
    "character_id": "zhuque",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 1,
    "pdf_page": 14,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "有鸟焉，其状如鸡，五采而文，名曰凤皇。",
    "note": "丹穴之山凤皇条，作为当前“朱雀/凤凰”档案的相关出处。正文是凤皇，不能据此把朱雀与凤皇直接等同。"
  },
  {
    "id": "song-1180-chenghuang-7",
    "character_id": "chenghuang",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 7,
    "pdf_page": 95,
    "scan_side": "right",
    "review_status": "located",
    "excerpt": "有乘黄，其状如狐，其背上有角，乘之寿二千岁。",
    "note": "海外西经白民之国条。"
  },
  {
    "id": "song-1180-bo-2",
    "character_id": "bo",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 2,
    "pdf_page": 32,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "其状如马而白身黑尾，一角，虎牙爪，音如鼓，其名曰驳，是食虎豹。",
    "note": "中曲之山条。"
  },
  {
    "id": "song-1180-yingzhao-2",
    "character_id": "yingzhao",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 2,
    "pdf_page": 25,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "实惟帝之平圃，神英招司之。",
    "note": "槐江之山条；形貌说明续至下一扫描页，可用阅读器“下一页”继续。"
  },
  {
    "id": "song-1180-zhuyan-2",
    "character_id": "zhuyan",
    "source_title": "《山海经》郭璞注·1180年宋刻本",
    "edition_id": "song-1180-chiyang",
    "chapter_number": 2,
    "pdf_page": 22,
    "scan_side": "left",
    "review_status": "located",
    "excerpt": "其状如猿而白首赤足，名曰朱厌，见则大兵。",
    "note": "西次二经小次之山条。"
  },
