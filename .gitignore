# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Node / Frontend
web/node_modules/
web/dist/

# Runtime data — 备份/日志/缩略图缓存/大包不入库
data/**/*.bak*
data/**/*_log.jsonl
data/**/*.zip
data/thumb-cache/

# C# build artifacts (legacy)
src/*/bin/
src/*/obj/

# IDE
.vs/
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
.DS_Store

# Sensitive config (contains API keys)
appsettings.Development.json
.env
# 令牌暂存文件——曾有并行会话在仓库根写出过 _tok.txt(内含 live token),
# 显式忽略,防止 git add -A 误纳入公开仓库。
_tok.txt
*_tok.txt

# Nginx 运行时配置(deploy 脚本按证书状态生成)
deploy/nginx/_active.conf

# Grafana runtime data
deploy/grafana/data/

# Logs & temp output
*.log
_server*
_ssr_*
output/

# 素材大包不入库（超 GitHub 100MB 限制）
resouce/*.zip
resouce/**/*.zip

# Built frontend assets (regenerated by npm run build)
wwwroot/assets/

# CodeGraph local index cache
.codegraph/
_v3_work/
